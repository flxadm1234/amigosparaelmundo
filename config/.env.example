# ============================================
# ASOCIACIÓN CIVIL AMIGOS POR EL MUNDO
# Archivo de entorno de ejemplo
# Copia este archivo a .env y edita los valores
# ============================================

# --- Base de Datos ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=amigos_mundo
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# --- Configuración del Sitio ---
APP_URL=http://localhost:8000
APP_ENV=production
APP_DEBUG=false

# --- Seguridad ---
# Cambia esta clave por una cadena aleatoria larga
APP_KEY=CAMBIA_ESTA_CADENA_POR_UNA_ALEATORIA_LARGA_MUY_SEGURA_123456789

# --- Subida de archivos ---
# Tamaño máximo en MB
MAX_UPLOAD_MB=32
